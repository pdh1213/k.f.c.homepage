{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "installCommand": "echo Static download site",
  "buildCommand": "echo Static download site",
  "redirects": [
    {
      "source": "/KFC-Chat-Setup.exe",
      "destination": "https://github.com/pdh1213/k.f.c.homepage/releases/download/chat-windows-latest/KFC-Chat-Setup.exe",
      "permanent": false
    }
  ]
}
