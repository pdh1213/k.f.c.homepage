{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "web-build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://mzlqksaprteljlcjnxix.supabase.co; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npx tsc --noEmit -p web/tsconfig.json && npx vite build --config web/vite.config.ts",
  "redirects": [
    {
      "source": "/KFC-Chat-Setup.exe",
      "destination": "https://github.com/pdh1213/k.f.c.homepage/releases/download/chat-windows-latest/KFC-Chat-Setup.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/download",
      "destination": "/download.html"
    }
  ]
}
