{
  "name": "kfc-robot-club",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "용인시청소년수련관 로봇동아리 K.F.C. 공식 홈페이지와 Windows 앱",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "vite --host 0.0.0.0",
    "build:win": "node scripts/build-windows.mjs",
    "dist:win": "node scripts/copy-installer.mjs",
    "pack:win": "npm run build:win && npm run dist:win",
    "lint": "node --check electron/main.cjs && node --check electron/preload.cjs",
    "portable:package": "powershell -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
  },
  "build": {
    "appId": "kr.kfcrobot.club",
    "productName": "K.F.C. 로봇동아리",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!electron/*-preview.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KFC-Club-Setup-${version}.exe",
      "icon": "electron/kfc-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "K.F.C. 로봇동아리"
    },
    "npmRebuild": false,
    "toolsets": {
      "nsis": "1.2.1"
    },
    "publish": {
      "useMultipleRangeRequest": false,
      "provider": "generic",
      "url": "https://github.com/pdh1213/k.f.c.homepage/releases/download/windows-latest/"
    }
  },
  "dependencies": {
    "@blobatar/react": "2.7.0",
    "@supabase/supabase-js": "^2.118.0",
    "blobatar": "2.7.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7"
  }
}
